{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaghir/looplet/blob/master/cartridge.schema.json",
  "title": "Looplet cartridge manifest",
  "description": "Machine-readable schema for cartridge.json under Cartridge Spec v2.0.",
  "type": "object",
  "required": ["name", "schema_version"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "default": "python"
    },
    "metadata": {
      "type": "object"
    }
  }
}
